{
  "name": "leash-device",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leash agent app: runs on the Raspberry Pi, holds every signing key",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "enroll:finger": "tsx scripts/enroll-finger.ts",
    "enroll:world": "tsx scripts/enroll-world.ts",
    "ask": "tsx scripts/ask.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@hiero-ledger/sdk": "2.90.1",
    "@hono/node-server": "^1.19.0",
    "@x402/core": "2.30.0",
    "@x402/hedera": "2.30.0",
    "dotenv": "^17.2.0",
    "ethers": "6.13.1",
    "hono": "^4.10.0",
    "jose": "^6.2.15",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "esbuild",
      "protobufjs"
    ]
  }
}
