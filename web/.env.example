# Application origin must exactly match the browser origin.
APP_URL=http://localhost:3000
# Local compose defaults only. Use managed credentials for deployed databases.
DATABASE_URL=postgres://shagun:shagun@localhost:54329/shagun
# Generate a random 32-byte key encoded as 64 hex characters.
# Back up with the database. In-place rotation is not supported.
DATA_ENCRYPTION_KEY=

# Public Privy app ID only. Enable embedded Ethereum wallets and allow the app origin.
NEXT_PUBLIC_PRIVY_APP_ID=

# Whitechain Sepolia. Do not use the similarly named chain 2625 endpoint.
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
VAULT_ADDRESS=
VAULT_DEPLOY_BLOCK=0
RELAYER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
PAYOUT_TREASURY_ADDRESS=
VAULT_ADMIN_ADDRESS=
CHAIN_CONFIRMATIONS=1
MAX_GAS_PER_TX=600000
MAX_GAS_PRICE_WEI=1000000000000
MAX_DAILY_GAS_WBT=0.1
MAX_GIFTS_PER_SENDER_DAY=30
MAX_CLAIMS_PER_HUMAN_DAY=5
MAX_SESSIONS_PER_HOUR=120
# Enable only behind a proxy that strips/sets trusted forwarded headers.
TRUST_PROXY=0

# Pin World IDKit v4 Proof of Human. Action: shagun-human.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=production

# Stripe Issuing SANDBOX only. Live keys and livemode objects are rejected.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Issuing real-time authorization endpoint (/api/webhooks/stripe/authorization).
STRIPE_AUTHORIZATION_WEBHOOK_SECRET=
# Signing secret of the Issuing event endpoint (/api/webhooks/stripe/events).
STRIPE_EVENTS_WEBHOOK_SECRET=
# Optional. Must equal the version pinned by the installed SDK.
STRIPE_API_VERSION=2026-10-28.endive
# Printed by `pnpm stripe:phase0 card`. Used only by the development card page.
STRIPE_PHASE0_CARD_ID=

# RazorpayX TEST mode only. Live keys are rejected.
# Payment-gateway access alone does not establish RazorpayX payout access.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# Indicative demo rate, snapshotted for each new gift.
PAYOUT_INR_PER_USDT=84.00

# Optional tooling:
# E2E_DATABASE_URL=postgres://shagun:shagun@localhost:54329/shagun
# SHAGUN_BUILD_DIR=.next-build
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
