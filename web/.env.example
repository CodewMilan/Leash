NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_USDC_TOKEN_ID=0.0.429274
NEXT_PUBLIC_LEASH_ACCOUNT_ID=
NEXT_PUBLIC_HCS_TOPIC_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEVICE_URL=http://leash.local:7070

# Lithic sandbox only — never put these in NEXT_PUBLIC variables
LITHIC_API_KEY=
LITHIC_SANDBOX_ACCESS_CODE=
# Optional account holder account_token if your program requires one
LITHIC_ACCOUNT_TOKEN=
# Optional: enables a link to the issued card in your dashboard
LITHIC_PROGRAM_TOKEN=
# Persistent writable directory; defaults to web/.data/lithic when started in web/
LITHIC_DATA_DIR=

# Wallet checkout: Base Sepolia only. Public receiving address, not a buyer wallet.
BASE_SEPOLIA_TREASURY_ADDRESS=
# Optional server RPC; the app checks chain ID 84532 and rejects any other chain.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional recovery key for a locally generated TESTNET treasury; never sent to clients.
# The checkout itself does not need or use this key to sign transactions.
BASE_SEPOLIA_TREASURY_PRIVATE_KEY=
