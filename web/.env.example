# Copy to .env.local. All values are public (account and topic IDs), no secrets here.
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Leash's Hedera account (same as HEDERA_ACCOUNT_ID on the device)
NEXT_PUBLIC_LEASH_ACCOUNT_ID=
# HCS topic the device writes the spend log to
NEXT_PUBLIC_HCS_TOPIC_ID=
# Testnet USDC (HTS)
NEXT_PUBLIC_USDC_TOKEN_ID=0.0.429274
# The device's read-only live feed (device/ serves it on port 7070)
NEXT_PUBLIC_DEVICE_URL=http://leash.local:7070
