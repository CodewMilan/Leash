{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.mts",
    "chain:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-chain.mts",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env.local --import tsx scripts/deploy-vault.mts",
    "test:e2e": "playwright test",
    "prebuild": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@gsap/react": "^2.1.2",
    "@openzeppelin/contracts": "^5.0.2",
    "@privy-io/react-auth": "^3.51.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@worldcoin/idkit": "^4.6.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "ethers": "^6.17.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "ganache": "^7.9.2",
    "solc": "^0.8.38",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.14.0"
}
