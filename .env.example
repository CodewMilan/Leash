# ---- Leash device (Raspberry Pi): holds every key that signs ----

# 0G Compute Router (OpenAI-compatible; key from https://pc.0g.ai, starts with sk-)
ZG_API_KEY=
# Optional overrides
# ZG_BASE_URL=https://router-api.0g.ai/v1
# ZG_MODEL=0gm-1.0-35b-a3b
# 0G wallet with Galileo testnet tokens (https://faucet.0g.ai), signs the episode log uploads to 0G Storage
ZG_PRIVATE_KEY=
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Hedera testnet: Leash's wallet, signs every payment and spend log entry
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# ECDSA (portal default) or ED25519; only needed when the key is raw hex rather than DER
HEDERA_KEY_TYPE=ECDSA
# Testnet USDC (HTS)
HEDERA_USDC_TOKEN_ID=0.0.429274
# Created by `pnpm setup:hedera` in device/; submit key = device key
HEDERA_SPEND_LOG_TOPIC_ID=

# World ID Agent Pass = World IdP (OIDC device flow). Register a client at https://auth.world.org/portal
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# https://auth.world.org or https://sandbox.auth.world.org (credentials are per environment)
WORLD_ISSUER=https://auth.world.org
# basic (portal default, client_secret_basic) or post (client_secret_post)
WORLD_AUTH_METHOD=basic
# Owner's World ID subject; only they can approve. Set by `pnpm enroll:world` in device/
WORLD_OWNER_SUB=
# Optional comma-separated list of accepted acr values, e.g. https://world.org/oidc/acr/orb-v3
WORLD_REQUIRED_ACR=

# Demo spending limit in USDC; above this needs fingerprint + World ID
SPEND_LIMIT_USDC=5

# Hardware (Pi). LEASH_HARDWARE=none runs on a laptop with typed input only (over-limit payments are then refused)
LEASH_HARDWARE=pi
FINGERPRINT_PORT=/dev/ttyUSB0
MIC_DEVICE=plughw:1,0
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/home/pi/leash/device/models/ggml-base.en.bin
# APPROVE_FALLBACK=button   # only if the fingerprint sensor is not wired: approve button stands in for the thumb

# ---- Laptop: demo merchant (x402 endpoint) ----

# Hedera testnet: demo merchant receiving payments
MERCHANT_ACCOUNT_ID=
# Only used once by `pnpm setup` in merchant/ to associate USDC
MERCHANT_PRIVATE_KEY=
# x402.org (default), https://api.testnet.blocky402.com or https://testnet.facilitator.launa.dev
X402_FACILITATOR_URL=https://x402.org/facilitator
CHAI_PRICE_USDC=0.5
PHOTO_MAX_USDC=50
# The merchant also needs HEDERA_USDC_TOKEN_ID (same value as above)
