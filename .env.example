# ---- Leash device (Raspberry Pi): holds every key that signs ----

# 0G Private Computer (OpenAI-compatible inference)
ZG_API_KEY=
# 0G wallet with Galileo testnet tokens, signs the episode log uploads to 0G Storage
ZG_PRIVATE_KEY=

# Hedera testnet: Leash's wallet, signs every payment and spend log entry
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Testnet USDC (HTS)
HEDERA_USDC_TOKEN_ID=0.0.429274

# World ID Agent Pass (https://auth.world.org/portal)
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=

# Demo spending limit in USDC; above this needs fingerprint + World ID
SPEND_LIMIT_USDC=5

# ---- Laptop: demo merchant (x402 endpoint) ----

# Hedera testnet: demo merchant receiving payments (setup only, e.g. USDC association)
MERCHANT_ACCOUNT_ID=
MERCHANT_PRIVATE_KEY=
# The merchant also needs HEDERA_USDC_TOKEN_ID (same value as above)
